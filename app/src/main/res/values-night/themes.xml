<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NovelsHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/night_paper</item>
        <item name="colorPrimaryDark">@color/night_paper</item>
        <item name="colorPrimaryVariant">@color/night_paper</item>
        <item name="colorOnPrimary">@color/night_ink</item>
        <item name="colorSecondary">@color/night_gold</item>
        <item name="colorSecondaryVariant">@color/night_gold</item>
        <item name="colorOnSecondary">@color/night_paper</item>
        <item name="colorAccent">@color/night_gold</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/night_paper</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/night_paper</item>
        <item name="android:windowBackground">@color/night_paper</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="actionBarStyle">@style/Widget.NovelsHub.ActionBar</item>
        <item name="bottomNavigationStyle">@style/Widget.NovelsHub.BottomNav</item>
        <item name="colorControlActivated">@color/night_gold</item>
        <item name="android:textColorPrimary">@color/night_ink</item>
        <item name="android:textColorSecondary">@color/night_muted</item>
        <item name="android:windowAnimationStyle">@style/Animation.NovelsHub.Activity</item>
        <item name="alertDialogTheme">@style/Theme.NovelsHub.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.NovelsHub.AlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.NovelsHub.BottomSheet</item>

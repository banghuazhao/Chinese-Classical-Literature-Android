<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/book_load_error"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_32"
    android:paddingEnd="@dimen/space_32"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/book_load_error_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_cloud_off" />

    <TextView
        android:id="@+id/book_load_error_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:fontFamily="@font/cormorant_semibold"
        android:gravity="center"
        android:textAlignment="center"
        android:textSize="24sp"
        tools:text="This book isn’t downloaded yet" />

    <TextView
        android:id="@+id/book_load_error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textAlignment="center"
        android:textSize="14sp"
        tools:text="Connect to the internet and try again." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/book_load_error_retry"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:layout_marginTop="@dimen/space_20"
        android:minWidth="160dp"
        android:text="@string/error_try_again"
        app:cornerRadius="24dp"
        app:strokeWidth="1dp" />

</LinearLayout>

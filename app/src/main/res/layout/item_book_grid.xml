<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_8"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_8"
    android:paddingBottom="@dimen/space_12">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:layoutDirection="ltr">

        <View
            android:id="@+id/book_pages"
            android:layout_width="@dimen/cover_page_width"
            android:layout_height="0dp"
            android:layout_marginStart="-1dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_book_pages"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/book_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/book_cover"
            app:layout_constraintTop_toTopOf="@id/book_cover" />

        <androidx.cardview.widget.CardView
            android:id="@+id/book_cover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/cover_page_width"
            app:cardBackgroundColor="@color/paper_deep"
            app:cardCornerRadius="@dimen/cover_radius"
            app:cardElevation="@dimen/cover_elevation"
            app:cardMaxElevation="@dimen/cover_elevation"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/book_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/cover_placeholder" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_spine_fold"
                    android:importantForAccessibility="no" />

                <View
                    android:layout_width="@dimen/cover_spine_width"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_spine_highlight"
                    android:importantForAccessibility="no" />

                <FrameLayout
                    android:id="@+id/like_host"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:layout_gravity="bottom|end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/save_to_library"
                    android:focusable="true">

                    <View
                        android:layout_width="@dimen/star_scrim_size"
                        android:layout_height="@dimen/star_scrim_size"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_star_scrim"
                        android:importantForAccessibility="no" />

                    <com.sackcentury.shinebuttonlib.ShineButton
                        android:id="@+id/like"
                        android:layout_width="@dimen/star_visual"
                        android:layout_height="@dimen/star_visual"
                        android:layout_gravity="center"
                        android:clickable="false"
                        android:focusable="false"
                        app:allow_random_color="false"
                        app:btn_color="#C8C8C8"
                        app:btn_fill_color="@color/gold_fill"
                        app:siShape="@raw/star" />
                </FrameLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/book_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="start"
        android:includeFontPadding="false"
        android:lines="2"
        android:paddingTop="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.NovelsHub.BookTitle"
        android:textColor="@color/ink"
        tools:text="Pride and Prejudice" />

    <TextView
        android:id="@+id/book_match_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingTop="@dimen/space_4"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Matched in description"
        tools:visibility="visible" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/search_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="@dimen/space_4"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/search_result_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.NovelsHub.ListAuthor"
            android:textSize="13sp"
            tools:text="12 books" />

        <TextView
            android:id="@+id/search_genre_scope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.NovelsHub.ListAuthor"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="in Romance"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_4"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/search_suggestions_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/page_gutter"
            android:text="@string/search_suggestions_label"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/search_suggestion_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/page_gutter"
                android:paddingBottom="@dimen/space_4"
                app:singleLine="true" />
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>

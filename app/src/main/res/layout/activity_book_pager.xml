<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/book_pager_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/book_pager_page_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/reader_gutter"
            android:paddingEnd="@dimen/reader_gutter">

            <TextView
                android:id="@+id/book_pager_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="@font/cormorant_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_gravity="center_horizontal"
                android:letterSpacing="0.01"
                android:lineSpacingMultiplier="1.12"
                android:maxWidth="@dimen/reader_text_max_width"
                android:paddingTop="@dimen/space_40"
                android:textColor="@color/ink"
                android:textSize="29sp" />

            <View
                android:layout_width="48dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_20"
                android:layout_marginBottom="@dimen/space_8"
                android:background="@color/gold_soft"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/book_pager_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/librebaskerville_regular"
                android:layout_gravity="center_horizontal"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="8dp"
                android:lineSpacingMultiplier="1.25"
                android:maxWidth="@dimen/reader_text_max_width"
                android:paddingTop="@dimen/space_20"
                android:paddingBottom="@dimen/space_32"
                android:textIsSelectable="true"
                android:textSize="18sp" />

            <View
                android:layout_width="48dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/gold_soft"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/book_pager_chapter_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_16"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:maxWidth="@dimen/reader_text_max_width"
                android:textAllCaps="true"
                android:textColor="@color/ink_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/book_pager_chapter_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="48dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/book_pager_prev_chapter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:contentDescription="@string/previous_chapter"
                    android:text="@string/previous_chapter_button"
                    android:textAppearance="@style/TextAppearance.NovelsHub.ReaderNav"
                    app:cornerRadius="24dp"
                    app:strokeWidth="1dp" />

                <View
                    android:layout_width="@dimen/space_12"
                    android:layout_height="1dp"
                    android:importantForAccessibility="no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/book_pager_next_chapter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:contentDescription="@string/next_chapter"
                    android:text="@string/next_chapter_button"
                    android:textAppearance="@style/TextAppearance.NovelsHub.ReaderNav"
                    app:cornerRadius="24dp"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>

    <LinearLayout
        android:id="@+id/book_pager_chrome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="6dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            layout="@layout/include_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/book_pager_reading_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:contentDescription="@string/reading_progress"
            android:max="100"
            android:progress="0"
            app:indicatorColor="@color/gold"
            app:trackColor="@color/hairline"
            app:trackCornerRadius="0dp"
            app:trackThickness="3dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

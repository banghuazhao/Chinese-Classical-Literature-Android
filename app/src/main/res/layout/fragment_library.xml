<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical">

    <include
        android:id="@+id/search_panel_include"
        layout="@layout/include_search_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/library_list_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="true"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/space_16" />

        <LinearLayout
            android:id="@+id/empty_library"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="40dp"
            android:paddingEnd="40dp"
            android:visibility="invisible">

            <ImageView
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ill_empty_library" />

            <TextView
                android:id="@+id/textView_nodata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/cormorant_semibold"
                android:gravity="center"
                android:text="@string/NoBookInLibrary"
                android:textAlignment="center"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/textView_nodata_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/NoBookInLibrarySubtitle"
                android:textAlignment="center"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <include
            android:id="@+id/search_empty_include"
            layout="@layout/include_search_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>

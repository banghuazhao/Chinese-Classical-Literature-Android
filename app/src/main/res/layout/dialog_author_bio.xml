<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/author_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_gutter"
    android:paddingTop="@dimen/space_12"
    android:paddingEnd="@dimen/page_gutter"
    android:paddingBottom="@dimen/space_24">

    <View
        android:id="@+id/author_sheet_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_20"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/author_sheet_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/About_the_author"
        android:textAppearance="@style/TextAppearance.NovelsHub.SectionLabel"
        android:textColor="@color/gold" />

    <TextView
        android:id="@+id/author_sheet_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:fontFamily="@font/cormorant_semibold"
        android:lineSpacingMultiplier="1.05"
        android:textColor="@color/ink"
        android:textSize="28sp"
        tools:text="Jane Austen" />

    <View
        android:id="@+id/author_sheet_rule"
        android:layout_width="32dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_12"
        android:background="@color/gold"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/author_sheet_bio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.NovelsHub.Intro"
            android:textColor="@color/ink"
            tools:text="Jane Austen wrote six completed novels from the quiet of Hampshire." />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
